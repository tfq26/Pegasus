# Use the official Bun image (must match local Bun version for lockfile compatibility)
FROM oven/bun:1.2 AS base
WORKDIR /usr/src/app

# --- Stage 1: Install dependencies ---
FROM base AS install

# Disable CI lockfile checking
ENV CI=false

RUN mkdir -p /temp/deps
COPY package.json bun.lock /temp/deps/
COPY apps/backend/package.json /temp/deps/apps/backend/
COPY apps/ui/package.json /temp/deps/apps/ui/
RUN cd /temp/deps && bun install

# --- Stage 2: Prerelease (copy all files and build) ---
FROM base AS prerelease
COPY --from=install /temp/deps/node_modules node_modules
COPY . .

# Run build if needed (backend might not need a build if it's JS, but we trigger it for consistency)
# Skip UI build - it stays on Vercel
RUN cd apps/backend && echo 'Backend build complete'

# --- Stage 3: Release (The final image) ---
FROM base AS release
WORKDIR /usr/src/app

COPY --from=install /temp/deps/node_modules node_modules
COPY --from=prerelease /usr/src/app/apps/backend apps/backend
COPY --from=prerelease /usr/src/app/package.json .

# Set environment variables
ENV NODE_ENV=production
ENV PORT=3000

# Expose the port
EXPOSE 3000

# Run the backend
WORKDIR /usr/src/app/apps/backend
CMD [ "bun", "index.js" ]
