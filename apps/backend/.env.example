# Auth
WORKOS_API_KEY=sk_test_your_workos_api_key_here
WORKOS_CLIENT_ID=client_your_workos_client_id_here
WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback
JWT_SECRET=your_random_jwt_secret_min_32_chars

# Database (SurrealDB)
SURREAL_URL=ws://127.0.0.1:8000/rpc (or wss://your-cloud-instance.surreal.cloud/rpc)
SURREAL_USER=root
SURREAL_PASS=root
SURREAL_NS=test
SURREAL_DB=test

# AI Providers
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Networking
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-vercel-app.vercel.app

# Optional Integrations
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
RESEND_API_KEY=re_your_resend_api_key_here
DEVELOPER_EMAIL=your-email@example.com
ALPHAVANTAGE_KEY=your_alphavantage_key_here