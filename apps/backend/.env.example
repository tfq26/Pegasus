# ============================================
# AUTHENTICATION & SECURITY
# ============================================
WORKOS_API_KEY=sk_test_your_workos_api_key_here
WORKOS_CLIENT_ID=client_your_workos_client_id_here
WORKOS_REDIRECT_URI=http://localhost:3000/api/auth/callback
JWT_SECRET=your_random_jwt_secret_min_32_chars

# ============================================
# DATABASE - SURREALDB
# ============================================
SURREAL_URL=ws://127.0.0.1:8000/rpc
# For production cloud: wss://your-cloud-instance.surreal.cloud/rpc
SURREAL_USER=root
SURREAL_PASS=root
SURREAL_NS=main
SURREAL_DB=main

# ============================================
# DATABASE - TURSO (SQLite) - Optional
# ============================================
# TURSO_API=your_turso_api_token_here
# TURSO_DB_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your_turso_auth_token_here

# ============================================
# DATABASE - NEON (PostgreSQL) - Optional
# ============================================
# NEON_DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# ============================================
# AI PROVIDERS
# ============================================
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# ============================================
# PAYMENT PROCESSING - STRIPE
# ============================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ============================================
# EMAIL SERVICE - RESEND
# ============================================
RESEND_API_KEY=re_your_resend_api_key_here
DEVELOPER_EMAIL=your-email@example.com

# ============================================
# EXTERNAL DATA APIS
# ============================================
ALPHAVANTAGE_KEY=your_alphavantage_key_here
# OPENWEATHER_KEY=your_openweather_key_here

# ============================================
# CLOUD PROVIDER OAUTH (for resource management)
# ============================================
# Azure AD OAuth (for Azure Resource Manager access)
AZURE_OAUTH_CLIENT_ID=your_azure_app_client_id
AZURE_OAUTH_CLIENT_SECRET=your_azure_app_client_secret
AZURE_OAUTH_REDIRECT_URI=http://localhost:3000/api/cloud-auth/azure/callback
AZURE_OAUTH_TENANT=common

